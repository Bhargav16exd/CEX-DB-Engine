generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  side           String
  type           String
  price          Int
  quantity       Int
  filledQuantity Int
  status         String
  userId         String
  deleted        Boolean  @default(false)
  createdAt      DateTime @default(now())
  orderId        String   @id
  stockSymbol    String

  @@index([userId])
}

model Stock {
  id       Int     @id @default(autoincrement())
  title    String
  symbol   String
  imageurl String
  market   String
  deleted  Boolean @default(false)
}

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String
  balance  Int     @default(0)
  deleted  Boolean @default(false)
}

model Fill {
  id           Int      @id @default(autoincrement())
  makerID      String
  takerID      String
  makerOrderID String
  takerOrderID String
  quantity     Int
  market       String
  price        Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([makerOrderID])
  @@index([market])
  @@index([takerOrderID])
}
